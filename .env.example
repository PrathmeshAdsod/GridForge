# GridForge — Environment Variables Template
# Copy to frontend/.env.local and demo-store/.env.local
# NEVER commit .env.local files

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── Bright Data (Live Mode — optional for demo-only deployment) ───────────────
# Get token from: Bright Data Dashboard → Settings → Account
BRIGHT_DATA_API_TOKEN=your_bright_data_api_token

# Collector IDs from Scraper Studio (see SETUP.md for how to create them)
BRIGHT_DATA_DEMO_STORE_COLLECTOR_ID=c_xxxxxxxxxx
BRIGHT_DATA_LOOM_SOLAR_COLLECTOR_ID=c_xxxxxxxxxx  # optional second source

# ─── Demo Store ────────────────────────────────────────────────────────────────
# URL of the deployed demo store (Vercel URL after deploy)
DEMO_STORE_URL=https://gridforge-demo-store.vercel.app

# Secret token for the demo store admin API
# Use: openssl rand -hex 16  (or any random string)
DEMO_ADMIN_TOKEN=generate_a_random_secret_here
